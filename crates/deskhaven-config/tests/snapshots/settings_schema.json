{
  "rules": [
    {
      "keys": [
        "auth.email_code.enabled",
        "smtp.host",
        "smtp.from"
      ],
      "message": "auth.email_code.enabled requires smtp.host and smtp.from to be set"
    },
    {
      "keys": [
        "auth.session_idle_ttl",
        "auth.session_ttl"
      ],
      "message": "auth.session_idle_ttl must not exceed auth.session_ttl"
    },
    {
      "keys": [
        "auth.lockout.window",
        "auth.lockout.duration"
      ],
      "message": "auth.lockout.window must not exceed 4 × auth.lockout.duration (otherwise a single source can trip the per-username global lockout)"
    },
    {
      "keys": [
        "web_client.turn_credential",
        "web_client.ice_servers"
      ],
      "message": "web_client.turn_credential is sent to one TURN server: every turn: and turns: URL of web_client.ice_servers must name one host"
    }
  ],
  "settings": [
    {
      "category": "auth",
      "default": "30d",
      "description": "Absolute lifetime of client and console sessions.",
      "env": "DESKHAVEN_SETTINGS__AUTH__SESSION_TTL",
      "key": "auth.session_ttl",
      "max": "365d",
      "min": "5m",
      "pin_only": false,
      "sensitive": false,
      "type": "duration",
      "zero_allowed": false
    },
    {
      "category": "auth",
      "default": "7d",
      "description": "Sliding idle timeout of client and console sessions.",
      "env": "DESKHAVEN_SETTINGS__AUTH__SESSION_IDLE_TTL",
      "key": "auth.session_idle_ttl",
      "max": "365d",
      "min": "5m",
      "pin_only": false,
      "sensitive": false,
      "type": "duration",
      "zero_allowed": false
    },
    {
      "category": "auth",
      "default": 1000,
      "description": "Most usable client and console sessions one user holds; signing in once more ends the user's least recently used session. Every RustDesk client signed in to an account holds one session, so an account shared by more devices than this logs the least recently used device out.",
      "env": "DESKHAVEN_SETTINGS__AUTH__MAX_SESSIONS_PER_USER",
      "key": "auth.max_sessions_per_user",
      "max": 10000,
      "min": 1,
      "pin_only": false,
      "sensitive": false,
      "type": "u32",
      "zero_allowed": false
    },
    {
      "category": "auth",
      "default": 10,
      "description": "Minimum password length (the maximum is fixed at 256).",
      "env": "DESKHAVEN_SETTINGS__AUTH__PASSWORD__MIN_LENGTH",
      "key": "auth.password.min_length",
      "max": 256,
      "min": 8,
      "pin_only": false,
      "sensitive": false,
      "type": "u32",
      "zero_allowed": false
    },
    {
      "category": "auth",
      "default": 5,
      "description": "Failed logins per account within the window before it is locked.",
      "env": "DESKHAVEN_SETTINGS__AUTH__LOCKOUT__MAX_FAILURES",
      "key": "auth.lockout.max_failures",
      "max": 100,
      "min": 1,
      "pin_only": false,
      "sensitive": false,
      "type": "u32",
      "zero_allowed": false
    },
    {
      "category": "auth",
      "default": "15m",
      "description": "Window in which failed logins are counted.",
      "env": "DESKHAVEN_SETTINGS__AUTH__LOCKOUT__WINDOW",
      "key": "auth.lockout.window",
      "max": "1d",
      "min": "1m",
      "pin_only": false,
      "sensitive": false,
      "type": "duration",
      "zero_allowed": false
    },
    {
      "category": "auth",
      "default": "15m",
      "description": "Base lockout duration (exponential backoff is capped at 24h).",
      "env": "DESKHAVEN_SETTINGS__AUTH__LOCKOUT__DURATION",
      "key": "auth.lockout.duration",
      "max": "1d",
      "min": "1m",
      "pin_only": false,
      "sensitive": false,
      "type": "duration",
      "zero_allowed": false
    },
    {
      "category": "auth",
      "default": 20,
      "description": "Requests per minute per IP on login-type endpoints.",
      "env": "DESKHAVEN_SETTINGS__AUTH__IP_RATE_LIMIT__PER_MINUTE",
      "key": "auth.ip_rate_limit.per_minute",
      "max": 10000,
      "min": 1,
      "pin_only": false,
      "sensitive": false,
      "type": "u32",
      "zero_allowed": false
    },
    {
      "category": "auth",
      "default": "disabled",
      "description": "Self-service registration mode.",
      "env": "DESKHAVEN_SETTINGS__AUTH__REGISTRATION",
      "key": "auth.registration",
      "on_bad_row": "disabled",
      "pin_only": false,
      "sensitive": false,
      "type": "enum",
      "variants": [
        "disabled",
        "invite",
        "open"
      ]
    },
    {
      "category": "auth",
      "default": "off",
      "description": "Which users must enroll a second factor for password sign-ins (OIDC sign-ins never ask for it). A covered user without one is refused by the RustDesk client until they enroll in the web console, which asks them to at their next console sign-in.",
      "env": "DESKHAVEN_SETTINGS__AUTH__TFA__ENFORCE",
      "key": "auth.tfa.enforce",
      "on_bad_row": "admins",
      "pin_only": false,
      "sensitive": false,
      "type": "enum",
      "variants": [
        "off",
        "admins",
        "all"
      ]
    },
    {
      "category": "auth",
      "default": false,
      "description": "Allow email one-time codes as a second factor (requires SMTP).",
      "env": "DESKHAVEN_SETTINGS__AUTH__EMAIL_CODE__ENABLED",
      "key": "auth.email_code.enabled",
      "pin_only": false,
      "sensitive": false,
      "type": "bool"
    },
    {
      "category": "auth",
      "default": "user",
      "description": "Highest role an OIDC login may reach by linking an existing account by email (both sides verified, no TOTP, not LDAP); `off` never links by email. `admin` and `owner` let the identity provider take those accounts over by email: only with an IdP whose users cannot change their own email address.",
      "env": "DESKHAVEN_SETTINGS__AUTH__OIDC__LINK_EMAIL_MAX_ROLE",
      "key": "auth.oidc.link_email_max_role",
      "on_bad_row": "off",
      "pin_only": false,
      "sensitive": false,
      "type": "enum",
      "variants": [
        "off",
        "user",
        "admin",
        "owner"
      ]
    },
    {
      "category": "smtp",
      "default": "",
      "description": "SMTP server host name; empty = SMTP not configured.",
      "env": "DESKHAVEN_SETTINGS__SMTP__HOST",
      "format": "host",
      "key": "smtp.host",
      "max_length": 254,
      "pin_only": false,
      "sensitive": false,
      "type": "string"
    },
    {
      "category": "smtp",
      "default": 587,
      "description": "SMTP server port.",
      "env": "DESKHAVEN_SETTINGS__SMTP__PORT",
      "key": "smtp.port",
      "max": 65535,
      "min": 1,
      "pin_only": false,
      "sensitive": false,
      "type": "u32",
      "zero_allowed": false
    },
    {
      "category": "smtp",
      "default": "starttls",
      "description": "SMTP transport security.",
      "env": "DESKHAVEN_SETTINGS__SMTP__TLS",
      "key": "smtp.tls",
      "pin_only": false,
      "sensitive": false,
      "type": "enum",
      "variants": [
        "starttls",
        "tls",
        "none"
      ]
    },
    {
      "category": "smtp",
      "default": "",
      "description": "SMTP user name; empty = no authentication.",
      "env": "DESKHAVEN_SETTINGS__SMTP__USERNAME",
      "key": "smtp.username",
      "max_length": 254,
      "pin_only": false,
      "sensitive": false,
      "type": "string"
    },
    {
      "category": "smtp",
      "default": null,
      "description": "SMTP password.",
      "env": "DESKHAVEN_SETTINGS__SMTP__PASSWORD",
      "key": "smtp.password",
      "max_length": 255,
      "pin_only": false,
      "sensitive": true,
      "type": "secret"
    },
    {
      "category": "smtp",
      "default": "",
      "description": "Sender address of outgoing mail.",
      "env": "DESKHAVEN_SETTINGS__SMTP__FROM",
      "format": "email",
      "key": "smtp.from",
      "max_length": 254,
      "pin_only": false,
      "sensitive": false,
      "type": "string"
    },
    {
      "category": "devices",
      "default": true,
      "description": "Device endpoints check that id and uuid match the registered device.",
      "env": "DESKHAVEN_SETTINGS__DEVICES__VERIFY_UUID",
      "key": "devices.verify_uuid",
      "on_bad_row": true,
      "pin_only": false,
      "sensitive": false,
      "type": "bool"
    },
    {
      "category": "devices",
      "default": false,
      "description": "Accept `rustdesk --deploy` registrations. Refusing devices that were not deployed (`NOT_DEPLOYED`) is not in effect yet.",
      "env": "DESKHAVEN_SETTINGS__DEVICES__REQUIRE_DEPLOY",
      "key": "devices.require_deploy",
      "pin_only": false,
      "sensitive": false,
      "type": "bool"
    },
    {
      "category": "devices",
      "default": "1m",
      "description": "Interval for batch-writing device last-seen times.",
      "env": "DESKHAVEN_SETTINGS__DEVICES__LAST_SEEN_FLUSH",
      "key": "devices.last_seen_flush",
      "max": "1h",
      "min": "5s",
      "pin_only": false,
      "sensitive": false,
      "type": "duration",
      "zero_allowed": false
    },
    {
      "category": "devices",
      "default": "off",
      "description": "Apply the `preset-*` fields of a device's first sysinfo: `row` = owner, device group, note and strategy; `all` = also the address book entry (written as the owner). Presets let a device choose its own placement: enable only for controlled custom-client rollouts. Never applied while `devices.verify_uuid` is off.",
      "env": "DESKHAVEN_SETTINGS__DEVICES__ACCEPT_PRESETS",
      "key": "devices.accept_presets",
      "on_bad_row": "off",
      "pin_only": false,
      "sensitive": false,
      "type": "enum",
      "variants": [
        "off",
        "row",
        "all"
      ]
    },
    {
      "category": "addressbook",
      "default": 1000,
      "description": "Maximum peers per address book returned to clients (`max_peer_one_ab`).",
      "env": "DESKHAVEN_SETTINGS__ADDRESSBOOK__MAX_PEERS",
      "key": "addressbook.max_peers",
      "max": 100000,
      "min": 1,
      "pin_only": false,
      "sensitive": false,
      "type": "u32",
      "zero_allowed": false
    },
    {
      "category": "audit",
      "default": "365d",
      "description": "Retention of connection audit records; 0 = forever.",
      "env": "DESKHAVEN_SETTINGS__AUDIT__RETENTION__CONNECTION",
      "key": "audit.retention.connection",
      "max": "3650d",
      "min": "1d",
      "pin_only": false,
      "sensitive": false,
      "type": "duration",
      "zero_allowed": true
    },
    {
      "category": "audit",
      "default": "365d",
      "description": "Retention of file-transfer audit records; 0 = forever.",
      "env": "DESKHAVEN_SETTINGS__AUDIT__RETENTION__FILE",
      "key": "audit.retention.file",
      "max": "3650d",
      "min": "1d",
      "pin_only": false,
      "sensitive": false,
      "type": "duration",
      "zero_allowed": true
    },
    {
      "category": "audit",
      "default": "365d",
      "description": "Retention of alarm audit records; 0 = forever.",
      "env": "DESKHAVEN_SETTINGS__AUDIT__RETENTION__ALARM",
      "key": "audit.retention.alarm",
      "max": "3650d",
      "min": "1d",
      "pin_only": false,
      "sensitive": false,
      "type": "duration",
      "zero_allowed": true
    },
    {
      "category": "audit",
      "default": "180d",
      "description": "Retention of login audit records; 0 = forever.",
      "env": "DESKHAVEN_SETTINGS__AUDIT__RETENTION__LOGIN",
      "key": "audit.retention.login",
      "max": "3650d",
      "min": "1d",
      "pin_only": false,
      "sensitive": false,
      "type": "duration",
      "zero_allowed": true
    },
    {
      "category": "audit",
      "default": "730d",
      "description": "Retention of console audit records; 0 = forever.",
      "env": "DESKHAVEN_SETTINGS__AUDIT__RETENTION__CONSOLE",
      "key": "audit.retention.console",
      "max": "3650d",
      "min": "1d",
      "pin_only": false,
      "sensitive": false,
      "type": "duration",
      "zero_allowed": true
    },
    {
      "category": "signal",
      "default": [],
      "description": "Relay servers handed to clients by the signal server.",
      "env": "DESKHAVEN_SETTINGS__SIGNAL__RELAY_SERVERS",
      "item": "host:port",
      "key": "signal.relay_servers",
      "max_items": 32,
      "pin_only": false,
      "sensitive": false,
      "type": "host_port_list"
    },
    {
      "category": "signal",
      "default": false,
      "description": "Force all connections through a relay.",
      "env": "DESKHAVEN_SETTINGS__SIGNAL__ALWAYS_USE_RELAY",
      "key": "signal.always_use_relay",
      "pin_only": false,
      "sensitive": false,
      "type": "bool"
    },
    {
      "category": "signal",
      "default": false,
      "description": "Refuse the signal KeyExchange of clients from before version 1 (one key for both directions), and browser sessions relayed to devices that only speak it; clients that skip the exchange are not affected.",
      "env": "DESKHAVEN_SETTINGS__SIGNAL__REQUIRE_KX_V1",
      "key": "signal.require_kx_v1",
      "pin_only": false,
      "sensitive": false,
      "type": "bool"
    },
    {
      "category": "signal",
      "default": "allow",
      "description": "Connection ACL decision when no rule matches (not in effect yet).",
      "env": "DESKHAVEN_SETTINGS__SIGNAL__ACL__DEFAULT",
      "key": "signal.acl.default",
      "on_bad_row": "deny",
      "pin_only": false,
      "sensitive": false,
      "type": "enum",
      "variants": [
        "allow",
        "deny"
      ]
    },
    {
      "category": "signal",
      "default": "deny",
      "description": "Connection ACL decision when the control plane fails (fail closed; not in effect yet).",
      "env": "DESKHAVEN_SETTINGS__SIGNAL__ACL__ON_ERROR",
      "key": "signal.acl.on_error",
      "on_bad_row": "deny",
      "pin_only": false,
      "sensitive": false,
      "type": "enum",
      "variants": [
        "allow",
        "deny"
      ]
    },
    {
      "category": "updates",
      "default": true,
      "description": "While on, admins using the console make the server ask GitHub (api.github.com) for the latest deskhaven release at most once a day; off sends no request.",
      "env": "DESKHAVEN_SETTINGS__UPDATES__CHECK",
      "key": "updates.check",
      "on_bad_row": false,
      "pin_only": false,
      "sensitive": false,
      "type": "bool"
    },
    {
      "category": "web_client",
      "default": false,
      "description": "Let console users control their own devices from the browser (administrators and owners: every device). Off refuses every web client session.",
      "env": "DESKHAVEN_SETTINGS__WEB_CLIENT__ENABLED",
      "key": "web_client.enabled",
      "on_bad_row": false,
      "pin_only": true,
      "sensitive": false,
      "type": "bool"
    },
    {
      "category": "web_client",
      "default": "stun:stun.cloudflare.com:3478,stun:stun.l.google.com:19302,stun:stun.antisip.com:3478,stun:stun.nextcloud.com:443",
      "description": "ICE servers the browser uses for WebRTC: comma-separated `stun:`, `stuns:`, `turn:` or `turns:` URLs; empty: none. The defaults are the RustDesk client's public STUN servers.",
      "env": "DESKHAVEN_SETTINGS__WEB_CLIENT__ICE_SERVERS",
      "format": "ice_urls",
      "key": "web_client.ice_servers",
      "max_length": 1024,
      "pin_only": false,
      "sensitive": false,
      "type": "string"
    },
    {
      "category": "web_client",
      "default": "",
      "description": "User name for the `turn:` / `turns:` servers of `web_client.ice_servers`; empty: none. Handed to every browser that opens a web client session.",
      "env": "DESKHAVEN_SETTINGS__WEB_CLIENT__TURN_USERNAME",
      "key": "web_client.turn_username",
      "max_length": 255,
      "pin_only": false,
      "sensitive": false,
      "type": "string"
    },
    {
      "category": "web_client",
      "default": null,
      "description": "Credential for the TURN server of `web_client.ice_servers` (while it is set, every `turn:` / `turns:` URL there must name that one host, which receives it). Handed to every browser that opens a web client session: use a TURN account for that alone.",
      "env": "DESKHAVEN_SETTINGS__WEB_CLIENT__TURN_CREDENTIAL",
      "key": "web_client.turn_credential",
      "max_length": 255,
      "pin_only": false,
      "sensitive": true,
      "type": "secret"
    }
  ]
}
