{
  "openapi": "3.1.0",
  "info": {
    "title": "deskhaven admin API",
    "description": "Backs the deskhaven web console. Authenticated operations need the console session cookie; their security requirement names the role they need (session: any console session, also one that must first change its password or enrol a required second factor; self: any console user, admin: admin or owner, owner: owner; a session with an unfinished account setup gets 403 `setup_required` outside `session` operations). Every state-changing request (not GET, HEAD or OPTIONS) must send the `X-Deskhaven-CSRF` header with the value of the `__Host-deskhaven_csrf` cookie (any non-empty value without a session); cross-site browser requests are refused. Errors are `{\"error\": {\"code\", \"message\", \"details\"?}}` with a stable `code`.",
    "license": {
      "name": "AGPL-3.0-only",
      "identifier": "AGPL-3.0-only"
    },
    "version": "0.1.0-dev"
  },
  "paths": {
    "/admin/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Signs in with a password (see the module docs).",
        "operationId": "login",
        "parameters": [
          {
            "name": "X-Deskhaven-CSRF",
            "in": "header",
            "description": "The `__Host-deskhaven_csrf` cookie's value; any non-empty value without a session.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Signed in (cookies set), or a TOTP challenge",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "401": {
            "description": "Wrong username or password (`invalid_credentials`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "Disabled or unverified account (`account_disabled`, `account_unverified`), plain-HTTP console (`insecure_transport`), or `csrf_failed`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Malformed input (`validation_failed`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Too many attempts (`rate_limited`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Password hashing saturated (`unavailable`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {}
        ]
      }
    },
    "/admin/api/v1/auth/login/totp": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Completes a password login with a TOTP or recovery code.",
