        "security": [
          {}
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorBody": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "details": {
            "type": [
              "object",
              "null"
            ],
            "description": "Machine-readable context, e.g. `{\"fields\": {\"<path>\": [\"<problem>\"]}}` for\n`validation_failed`."
          },
          "message": {
            "type": "string",
            "description": "Human-readable, English; the console translates by `code`."
          }
        }
      },
      "ErrorCode": {
        "type": "string",
        "description": "Stable wire codes. Renaming one is a breaking API change.",
        "enum": [
          "validation_failed",
          "unauthorized",
          "forbidden",
          "csrf_failed",
          "not_found",
          "conflict",
          "rate_limited",
          "unsupported_media_type",
          "internal",
          "bad_request",
          "method_not_allowed",
          "payload_too_large",
          "timeout",
          "unavailable",
          "invalid_credentials",
          "account_disabled",
          "account_unverified",
          "invalid_code",
          "invalid_challenge",
          "wrong_password",
          "insecure_transport",
          "setup_required",
          "invalid_setup_token",
          "setup_completed",
          "oidc_failed",
          "not_local_account"
        ]
      },
      "ErrorEnvelope": {
        "type": "object",
        "description": "The error body of every admin API failure (08-web-console §6).",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "description": "Username and password. Never logged.",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "password": {
            "type": "string",
            "format": "password"
          },
          "username": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "LoginResponse": {
        "oneOf": [
          {
            "type": "object",
            "description": "Signed in: the session and CSRF cookies are set. When `user.setup_required` is set,\nthe session reaches only `/me`, the password change, the TOTP enrolment and logout\nuntil that step is done.",
            "required": [
              "user",
              "status"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "signed_in"
                ]
              },
              "user": {
                "$ref": "#/components/schemas/Me"
              }
            }
          },
          {
            "type": "object",
            "description": "The password was right and the account has TOTP: send a TOTP or recovery code with\nthis challenge to `POST /auth/login/totp` (valid 5 minutes, 5 codes). No cookie.",
            "required": [
              "challenge",
              "status"
            ],
            "properties": {
              "challenge": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "totp_required"
                ]
              }
            }
          }
        ],
        "description": "The answer of a sign-in step."
      },
      "Me": {
        "type": "object",
        "description": "The signed-in user's own account.",
        "required": [
          "id",
          "username",
          "display_name",
          "role",
          "must_change_password",
          "totp_enabled"
        ],
        "properties": {
          "display_name": {
            "type": "string"
          },
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "must_change_password": {
            "type": "boolean"
          },
          "role": {
            "$ref": "#/components/schemas/RoleView"
          },
          "setup_required": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/SetupStep",
                "description": "The account setup step this session must finish before anything else; `null` when\nnone. Until then only `/me`, the password change, the TOTP enrolment and logout\nanswer (others: 403 `setup_required`)."
              },
              {
                "type": "null"
              }
            ]
          },
          "totp_enabled": {
            "type": "boolean"
          },
          "username": {
            "type": "string"
          }
        }
      },
      "OidcCompleteRequest": {
        "type": "object",
        "description": "The IdP's answer, as it arrived on the callback (`?state=&code=` or `?state=&error=`).\nNever logged.",
        "required": [
          "state"
        ],
        "properties": {
          "code": {
            "type": [
              "string",
              "null"
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "OidcProvider": {
        "type": "object",
        "description": "An OIDC login button of the console.",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "The provider's name, the `provider` of `POST /auth/oidc/start`."
          }
        }
      },
      "OidcStart": {
        "type": "object",
        "description": "Where to send the browser.",
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string",
            "description": "The IdP's authorization URL."
          }
        }
      },
      "OidcStartRequest": {
        "type": "object",
        "required": [
          "provider"
        ],
        "properties": {
          "provider": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "PasswordChange": {
        "type": "object",
        "description": "Never logged.",
        "required": [
          "current_password",
          "new_password"
        ],
        "properties": {
          "current_password": {
            "type": "string",
            "format": "password"
          },
          "new_password": {
            "type": "string",
            "format": "password"
          }
        },
        "additionalProperties": false
      },
      "QrCode": {
        "type": "object",
        "description": "A QR code to draw: a square of `size` units, dark modules in `path`.",
        "required": [
          "size",
          "path"
        ],
        "properties": {
          "path": {
            "type": "string",
            "description": "SVG path data of the dark modules."
          },
          "size": {
            "type": "integer",
            "format": "int32",
            "description": "Side length in modules, quiet zone included (the SVG `viewBox` is `0 0 size size`)."
          }
        }
      },
      "RoleView": {
        "type": "string",
        "description": "Console role (06 §4.1).",
        "enum": [
          "owner",
          "admin",
          "user"
        ]
      },
      "SetupRequest": {
        "type": "object",
        "description": "The setup link's token and the owner to create. Never logged.",
        "required": [
          "token",
          "username",
          "password"
        ],
        "properties": {
          "display_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Blank: the username."
          },
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "password": {
            "type": "string",
            "format": "password"
          },
          "token": {
            "type": "string",
            "description": "The `token` of the setup link (`/setup#token=…`)."
          },
          "username": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "SetupStatus": {
        "type": "object",
        "description": "Whether the first-run setup is still open.",
        "required": [
          "required"
        ],
        "properties": {
          "public_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "The configured `public_url` (bootstrap configuration, changed by a restart); `null`\nwhen unset (OIDC and e-mail links need it)."
          },
          "required": {
            "type": "boolean",
            "description": "No owner exists yet."
          }
        }
      },
      "SetupStep": {
        "type": "string",
        "description": "The next account setup step of a console session.",
        "enum": [
          "password_change",
          "totp_enrolment"
        ]
      },
      "TotpConfirm": {
        "type": "object",
        "description": "Never logged.",
        "required": [
          "current_password",
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "A current six-digit code of the pending seed."
          },
          "current_password": {
            "type": "string",
            "format": "password",
            "description": "The account's current password (re-authentication)."
          }
        },
        "additionalProperties": false
      },
      "TotpEnabled": {
        "type": "object",
        "description": "TOTP is enabled: the recovery codes (shown once) and the user.",
        "required": [
          "recovery_codes",
          "user"
        ],
        "properties": {
          "recovery_codes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "user": {
            "$ref": "#/components/schemas/Me"
          }
        }
      },
      "TotpEnrolment": {
        "type": "object",
        "description": "A pending enrolment, shown once.",
        "required": [
          "secret",
          "uri",
          "qr"
        ],
        "properties": {
          "qr": {
            "$ref": "#/components/schemas/QrCode",
            "description": "The URI as a QR code."
          },
          "secret": {
            "type": "string",
            "description": "The seed in base32, for manual entry."
          },
          "uri": {
            "type": "string",
            "description": "`otpauth://` provisioning URI."
          }
        }
      },
      "TotpLoginRequest": {
        "type": "object",
        "description": "The challenge of the password step and a code. Never logged.",
        "required": [
          "username",
          "challenge",
          "code"
        ],
        "properties": {
          "challenge": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "description": "Six-digit TOTP code, or a recovery code (`xxxxx-xxxxx`)."
          },
          "username": {
            "type": "string",
            "description": "The username the password step was for."
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "console_session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-deskhaven_session",
        "description": "Console session token (HttpOnly; set by the console login)."
      }
    }
  }
}
