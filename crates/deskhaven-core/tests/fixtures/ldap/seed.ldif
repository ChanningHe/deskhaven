# Seed of the directory tests/ldap_server.rs runs against (osixia/openldap, base
# dc=example,dc=org, admin cn=admin,dc=example,dc=org). Groups are groupOfUniqueNames: the
# image's memberOf overlay maintains memberOf from uniqueMember.

dn: ou=people,dc=example,dc=org
objectClass: organizationalUnit
ou: people

dn: ou=groups,dc=example,dc=org
objectClass: organizationalUnit
ou: groups

dn: uid=alice,ou=people,dc=example,dc=org
objectClass: inetOrgPerson
uid: alice
cn: Alice Liddell
sn: Liddell
mail: alice@example.org
userPassword: alice-Dir-Pass-1

dn: uid=bob,ou=people,dc=example,dc=org
objectClass: inetOrgPerson
uid: bob
cn: Bob Builder
sn: Builder
userPassword: bob-Dir-Pass-2

dn: cn=ops,ou=groups,dc=example,dc=org
objectClass: groupOfUniqueNames
cn: ops
uniqueMember: uid=alice,ou=people,dc=example,dc=org

dn: cn=deskhaven-admins,ou=groups,dc=example,dc=org
objectClass: groupOfUniqueNames
cn: deskhaven-admins
uniqueMember: uid=alice,ou=people,dc=example,dc=org
