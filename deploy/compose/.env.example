# Address of this server as users and clients reach it (HTTPS via Caddy).
DESKHAVEN_PUBLIC_URL=https://rd.example.com
# Relay clients are sent to: the same host, port 21117.
DESKHAVEN_RELAY=rd.example.com:21117
# Makes plain `docker compose ...` use the HTTPS overlay as well.
COMPOSE_FILE=compose.yaml:compose.caddy.yaml
# RELAY_KEY=<public key> is appended after the first start (see compose.yaml).
