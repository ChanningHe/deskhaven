# Upstream RustDesk relay (hbbr) next to deskhaven (binary deployment).
#   install -m 0755 hbbr /usr/local/bin/hbbr     # from a rustdesk-server release
#   # the relay gets deskhaven's PUBLIC key only (never the private key, never "-"/"_"):
#   key=$(sudo -u deskhaven deskhaven key show | head -n1) && [ -n "$key" ] \
#     && install -d -m 0755 /etc/deskhaven && printf 'KEY=%s\n' "$key" > /etc/deskhaven/relay.env
#   install -m 0644 hbbr.service /etc/systemd/system/ && systemctl daemon-reload
#   systemctl enable --now hbbr
# Add the relay to signal.relay_servers (e.g. pin it in deskhaven.toml:
# [settings] "signal.relay_servers" = ["rd.example.com:21117"]).

[Unit]
Description=RustDesk relay (hbbr) for deskhaven
Documentation=https://github.com/rustdesk/rustdesk-server
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
DynamicUser=yes
# Required. hbbr fails open: with no key, or "-" / "_" when it cannot write a
# key pair, it relays for every client; a private key would be accepted too.
# So KEY must be a 32-byte public key in base64 (44 characters), checked here.
EnvironmentFile=/etc/deskhaven/relay.env
ExecStartPre=/bin/sh -c 'printf "%%s" "$${KEY:-}" | grep -Eqx "[A-Za-z0-9+/]{42}[AEIMQUYcgkosw048]=" || { echo "hbbr: KEY in /etc/deskhaven/relay.env is not a deskhaven public key" >&2; exit 1; }'
# The key comes from KEY only; never add -k to this line.
ExecStart=/usr/local/bin/hbbr
Restart=on-failure
RestartSec=5s
# hbbr reads .env, blacklist.txt and blocklist.txt from its working directory;
# start it in an empty one.
RuntimeDirectory=hbbr
RuntimeDirectoryMode=0700
WorkingDirectory=/run/hbbr
LimitNOFILE=65536

# Hardening: unprivileged ports only, no capabilities, writes only to /run/hbbr.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
