# deskhaven as a systemd service (binary deployment).
#   install -m 0755 deskhaven /usr/local/bin/deskhaven
#   useradd --system --home-dir /var/lib/deskhaven --shell /usr/sbin/nologin deskhaven
#   install -m 0644 deskhaven.service /etc/systemd/system/ && systemctl daemon-reload
#   systemctl enable --now deskhaven && journalctl -u deskhaven   # first-run link
# Configuration: /etc/deskhaven/deskhaven.toml (optional; defaults otherwise).
#
# Firewall (nftables, e.g. included from /etc/nftables.conf). hbbr's WebSocket
# port 21119 has no bind setting and listens on all interfaces but is for the
# local TLS proxy only (deskhaven's 21118 is bound to loopback below; the rule
# keeps it closed for a configuration that drops that line); 21117 also
# carries hbbr's command console for loopback peers, kept from local users
# here (root keeps it). Safe for relaying: hbbr answers loopback peers only as
# that console, never relays for them, and never connects to itself.
#   table inet deskhaven {
#     chain in  { type filter hook input priority 0; iifname != "lo" tcp dport { 21118, 21119 } drop; }
#     chain out { type filter hook output priority 0; oifname "lo" ip daddr 127.0.0.0/8 tcp dport 21117 meta skuid != 0 drop; oifname "lo" ip6 daddr ::1 tcp dport 21117 meta skuid != 0 drop; }
#   }

[Unit]
Description=deskhaven (RustDesk server: rendezvous, client API, web console)
Documentation=https://github.com/ChanningHe/deskhaven
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=deskhaven
Group=deskhaven
ExecStart=/usr/local/bin/deskhaven serve
# HTTP (console, client API, logins) only on loopback, behind the TLS proxy
# (../nginx/deskhaven.conf), which is the one trusted for X-Forwarded-For.
# The rendezvous WebSocket (21118) likewise: clients use wss via the proxy.
Environment=DESKHAVEN_LISTEN__CLIENT_API=127.0.0.1:21114
Environment=DESKHAVEN_SIGNAL__WS_LISTEN=127.0.0.1:21118
Environment=DESKHAVEN_SECURITY__TRUSTED_PROXIES=127.0.0.1/32
Restart=on-failure
RestartSec=5s
# deskhaven drains for at most 10s after SIGTERM.
TimeoutStopSec=15s
# /var/lib/deskhaven: key pair, master key, SQLite database (back it up).
StateDirectory=deskhaven
StateDirectoryMode=0700
UMask=0077
LimitNOFILE=65536

# Hardening: unprivileged ports only, no capabilities, writes only to the state dir.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
