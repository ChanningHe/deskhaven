# deskhaven as a systemd service (binary deployment).
#   install -m 0755 deskhaven /usr/local/bin/deskhaven
#   useradd --system --home-dir /var/lib/deskhaven --shell /usr/sbin/nologin deskhaven
#   install -m 0644 deskhaven.service /etc/systemd/system/ && systemctl daemon-reload
#   systemctl enable --now deskhaven && journalctl -u deskhaven   # first-run link
# Configuration: /etc/deskhaven/deskhaven.toml (optional; defaults otherwise).

[Unit]
Description=deskhaven (RustDesk server: rendezvous, client API, web console)
Documentation=https://github.com/ChanningHe/deskhaven
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=deskhaven
Group=deskhaven
ExecStart=/usr/local/bin/deskhaven serve
Restart=on-failure
RestartSec=5s
# deskhaven drains for at most 10s after SIGTERM.
TimeoutStopSec=15s
# /var/lib/deskhaven: key pair, master key, SQLite database (back it up).
StateDirectory=deskhaven
StateDirectoryMode=0700
UMask=0077
LimitNOFILE=65536

# Hardening: unprivileged ports only, no capabilities, writes only to the state dir.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
