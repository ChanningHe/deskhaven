#!/usr/bin/env bash
# Only `git ls-remote` is stubbed; every other command runs the real git.
if [ "${1:-}" = ls-remote ]; then
  tag="${4%^\{\}}"
  tag="${tag#refs/tags/}"
  sha=""
  if [ -n "${STUB_TAG_FILE:-}" ]; then
    sha="$(awk -v t="$tag" '$1 == t { print $2 }' "$STUB_TAG_FILE")"
  else
    sha="${STUB_TAG_SHA:-}"
  fi
  # STUB_TAG_FLIP_AFTER=<n>: from the (n+1)-th ls-remote on, the tag points to STUB_TAG_SHA_LATER
  if [ -n "${STUB_TAG_FLIP_AFTER:-}" ] && [ -n "${STUB_DIR:-}" ]; then
    calls=$(($(cat "$STUB_DIR/lsremote.count" 2>/dev/null || echo 0) + 1))
    echo "$calls" >"$STUB_DIR/lsremote.count"
    if [ "$calls" -gt "$STUB_TAG_FLIP_AFTER" ]; then sha="${STUB_TAG_SHA_LATER:-}"; fi
  fi
  [ -n "$sha" ] || exit 0
  if [ "${STUB_TAG_ANNOTATED:-0}" = 1 ]; then
    printf '%s\trefs/tags/%s\n' "1111111111111111111111111111111111111111" "$tag"
    printf '%s\trefs/tags/%s^{}\n' "$sha" "$tag"
  else
    printf '%s\trefs/tags/%s\n' "$sha" "$tag"
  fi
  exit 0
fi
self_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
real="$(PATH="$(printf '%s' "$PATH" | tr ':' '\n' | grep -vxF "$self_dir" | paste -sd: -)" command -v git)"
exec "$real" "$@"
