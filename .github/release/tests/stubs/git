#!/usr/bin/env bash
# git stub: `git ls-remote URL refs/tags/T refs/tags/T^{}` answers from the environment, all
# other commands run the real git.
#   STUB_TAG_FILE       lines "<tag> <commit>"; the tag is absent if not listed
#   STUB_TAG_SHA        (alternative) the commit EVERY tag points to
#   STUB_TAG_ANNOTATED  1: also print a tag object line before the peeled commit line
if [ "${1:-}" = ls-remote ]; then
  tag="${4%^\{\}}"
  tag="${tag#refs/tags/}"
  sha=""
  if [ -n "${STUB_TAG_FILE:-}" ]; then
    sha="$(awk -v t="$tag" '$1 == t { print $2 }' "$STUB_TAG_FILE")"
  else
    sha="${STUB_TAG_SHA:-}"
  fi
  [ -n "$sha" ] || exit 0
  if [ "${STUB_TAG_ANNOTATED:-0}" = 1 ]; then
    printf '%s\trefs/tags/%s\n' "1111111111111111111111111111111111111111" "$tag"
    printf '%s\trefs/tags/%s^{}\n' "$sha" "$tag"
  else
    printf '%s\trefs/tags/%s\n' "$sha" "$tag"
  fi
  exit 0
fi
# the real git: the first `git` on PATH that is not this stub
self_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
real="$(PATH="$(printf '%s' "$PATH" | tr ':' '\n' | grep -vxF "$self_dir" | paste -sd: -)" command -v git)"
exec "$real" "$@"
