root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{ts,tsx,js,jsx,json,yml,yaml,css,html,nix,md}]
indent_size = 2

[Makefile]
indent_style = tab

# Vendored upstream sources: keep bytes verbatim (must come last so it overrides the rules above).
[crates/deskhaven-signal/upstream-src/**]
charset = unset
end_of_line = unset
indent_style = unset
indent_size = unset
trim_trailing_whitespace = false
insert_final_newline = false
